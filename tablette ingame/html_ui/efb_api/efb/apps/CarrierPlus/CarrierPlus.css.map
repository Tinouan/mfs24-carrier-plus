.carrier-plus-app {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #1a1a24;
  color: #ffffff;
  font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
}

.tabs {
  display: flex;
  flex-shrink: 0;
  padding: 8px 12px;
  background: #252532;
  border-bottom: 1px solid #374151;
  gap: 8px;
}

.content {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.tab-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
  flex-direction: column;
}

.visible {
  display: flex !important;
}

.hidden {
  display: none !important;
}

.mock-banner {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
  text-align: center;
  padding: 6px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  flex-shrink: 0;
}

.status-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  background: #252532;
  border-bottom: 1px solid #374151;
  flex-shrink: 0;
}
.status-header .status-label {
  font-size: 12px;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.status-badge {
  font-size: 14px;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 4px;
}
.status-badge.ground {
  background: rgba(34, 197, 94, 0.2);
  color: #22c55e;
}
.status-badge.flight {
  background: rgba(59, 130, 246, 0.2);
  color: #60a5fa;
}

.data-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 16px;
  flex: 1;
  overflow-y: auto;
}

.data-card {
  background: #252532;
  border-radius: 8px;
  padding: 12px;
  border: 1px solid transparent;
}
.data-card.wide {
  grid-column: span 2;
}

.card-label {
  font-size: 10px;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 8px;
}

.card-value {
  display: flex;
  align-items: baseline;
  gap: 4px;
}
.card-value.coords {
  flex-direction: column;
  gap: 2px;
}
.card-value.coords span {
  font-family: "Consolas", "Monaco", monospace;
  font-size: 13px;
  color: #f59e0b;
}
.card-value .number {
  font-size: 20px;
  font-weight: 600;
  font-family: "Consolas", "Monaco", monospace;
  color: #ffffff;
}
.card-value .unit {
  font-size: 12px;
  color: #9ca3af;
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 32px;
  text-align: center;
}
.placeholder h2 {
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
  margin: 0 0 8px 0;
}
.placeholder p {
  font-size: 14px;
  color: #9ca3af;
  margin: 4px 0;
}

.map-container {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 100%;
}

.map-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  background: #252532;
  border-bottom: 1px solid #374151;
  flex-shrink: 0;
}
.map-header .map-title {
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
}
.map-header .map-coords {
  font-family: "Consolas", "Monaco", monospace;
  font-size: 12px;
  color: #f59e0b;
}

.map-frame {
  flex: 1;
  min-height: 0;
  background: #0a0a0f;
}
.map-frame iframe {
  width: 100%;
  height: 100%;
  border: none;
}

.map-legend {
  padding: 8px 16px;
  background: #252532;
  border-top: 1px solid #374151;
  flex-shrink: 0;
}
.map-legend p {
  font-size: 11px;
  color: #6b7280;
  margin: 2px 0;
}
